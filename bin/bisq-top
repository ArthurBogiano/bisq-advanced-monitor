#!/usr/bin/env python3
import curses, json
from datetime import datetime
from pathlib import Path

STATE = Path.home()/".local/state/bisq-monitor/state.json"

def load():
    try: return json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {"offers":{},"events":[],"healthy":False,"last_error":"Monitor sem estado"}

def cut(value, width):
    value=str(value).replace("\n"," ")
    return value if len(value)<=width else value[:max(0,width-1)]+"…"

def put(w,y,x,text,style=0):
    h,cols=w.getmaxyx()
    if y<h and x<cols:
        try: w.addnstr(y,x,str(text),max(0,cols-x-1),style)
        except curses.error: pass

def age(value):
    try:
        sec=max(0,int((datetime.now().astimezone()-datetime.fromisoformat(value)).total_seconds()))
        return f"{sec}s" if sec<60 else f"{sec//60}min"
    except (TypeError,ValueError): return "nunca"

def money(value, currency):
    try:
        number=float(value)
        rendered=f"{number:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")
        return ("R$ " if currency=="BRL" else "€ ")+rendered
    except (TypeError,ValueError): return "—"

def number(value):
    return float(str(value).replace(",", "").strip())

def converted_range(value, rate):
    import re
    values=re.findall(r"[0-9][0-9,]*(?:\.[0-9]+)?",str(value))
    return " – ".join(money(number(item)*rate,"BRL") for item in values) or "—"

def btc_amounts(value):
    import re
    values=[float(item) for item in re.findall(r"[0-9]+(?:\.[0-9]+)?",str(value))]
    return (values[0],values[-1]) if values else (0.0,0.0)

def render_range(values,formatter):
    low,high=values
    return formatter(low) if abs(low-high)<1e-12 else f"{formatter(low)} – {formatter(high)}"

def opportunity_details(item, prices):
    currency=item.get("currency","")
    btc_brl=number(prices.get("BRL",0)); btc_eur=number(prices.get("EUR",0))
    eur_brl=btc_brl/btc_eur if btc_eur else 0
    amounts=btc_amounts(item.get("btc_range",""))
    offer_price=number(item.get("offer_price",0)); market_price=number(item.get("market_price",0))
    capital_brl=tuple(value*offer_price*(eur_brl if currency=="EUR" else 1) for value in amounts)
    capital_eur=tuple(value*offer_price/(eur_brl if currency=="BRL" else 1) for value in amounts)
    gross_native=tuple(abs(offer_price-market_price)*value for value in amounts)
    gross_brl=tuple(value*(eur_brl if currency=="EUR" else 1) for value in gross_native)
    gross_eur=tuple(value/(eur_brl if currency=="BRL" else 1) for value in gross_native)
    deposit_pct=float(item.get("taker_deposit_pct",0))
    deposit_btc=tuple(value*deposit_pct/100 for value in amounts)
    mining_sats=int(item.get("tx_fee_rate_sat_vbyte",0))*233
    taker_fees=(int(item.get("min_taker_fee_sats",0)),int(item.get("max_taker_fee_sats",0)))
    fee_btc=tuple((value+mining_sats)/1e8 for value in taker_fees)
    wallet_btc=(tuple(deposit+fee for deposit,fee in zip(deposit_btc,fee_btc))
                if item.get("action")=="COMPRAR BTC" else
                tuple(value+deposit+fee for value,deposit,fee in zip(amounts,deposit_btc,fee_btc)))
    wallet_brl=tuple(value*btc_brl for value in wallet_btc)
    wallet_eur=tuple(value*btc_eur for value in wallet_btc)
    net_native=tuple(gross-fee*market_price for gross,fee in zip(gross_native,fee_btc))
    net_brl=tuple(value*(eur_brl if currency=="EUR" else 1) for value in net_native)
    net_eur=tuple(value/(eur_brl if currency=="BRL" else 1) for value in net_native)
    lines=[
        "OPORTUNIDADE BISQ",
        f"🎯 {item.get('action','—')} • {float(item.get('advantage_pct',0)):.2f}% de vantagem",
        f"💳 {item.get('payment','—')} • {currency}",
        "",
        f"🏷 Oferta: {money(item.get('offer_price'),currency)} / BTC",
    ]
    if currency=="EUR":
        lines += [
            f"📊 Mercado: {money(btc_eur,'EUR')} / BTC",
            f"🇧🇷 Oferta em reais: {money(number(item.get('offer_price',0))*eur_brl,'BRL')} / BTC",
        ]
    else:
        lines += [f"📊 Mercado: {money(btc_brl,'BRL')} / BTC"]
    lines += [
        f"₿ Quantidade: {item.get('btc_range','—')} BTC",
        f"💵 Valor: {item.get('fiat_range','—')} {currency}",
    ]
    if currency=="EUR":
        lines += [f"🇧🇷 Equivalente: {converted_range(item.get('fiat_range',''),eur_brl)}"]
    required=(render_range(amounts,lambda value:f"{value:.8f}")+" BTC"
              if item.get("action")=="VENDER BTC" else
              render_range(capital_brl if currency=="BRL" else capital_eur,
                           lambda value:money(value,currency)))
    lines += [
        "",
        "💼 PARA ACEITAR",
        f"👛 Principal: {required}",
        f"🔐 Depósito de segurança: {deposit_pct:.2f}% = {render_range(deposit_btc,lambda value:f'{value:.8f}')} BTC",
        f"🧾 Taxas estimadas: {render_range(fee_btc,lambda value:f'{value:.8f}')} BTC",
        f"👛 Carteira: {render_range(wallet_btc,lambda value:f'{value:.8f}')} BTC",
        f"🇧🇷 Equivalente: {render_range(wallet_brl,lambda value:money(value,'BRL'))}",
    ]
    if currency=="EUR":
        lines += [
            f"🇪🇺 Equivalente: {render_range(wallet_eur,lambda value:money(value,'EUR'))}",
            f"✅ Resultado líquido estimado: {render_range(net_eur,lambda value:money(value,'EUR'))}",
            f"🇧🇷 Em reais: {render_range(net_brl,lambda value:money(value,'BRL'))}",
        ]
    else:
        lines += [f"✅ Resultado líquido estimado: {render_range(net_brl,lambda value:money(value,'BRL'))}"]
    lines += ["", f"🆔 {item.get('id','—')}", "ℹ Depósito devolvido ao concluir. Confirme os valores na Bisq."]
    return lines

def main(w):
    curses.curs_set(0); w.timeout(1000); curses.start_color(); curses.use_default_colors()
    for n,fg,bg in ((1,curses.COLOR_GREEN,-1),(2,curses.COLOR_RED,-1),
                    (3,curses.COLOR_YELLOW,-1),(4,curses.COLOR_CYAN,-1),
                    (5,curses.COLOR_BLACK,curses.COLOR_GREEN)): curses.init_pair(n,fg,bg)
    scroll=0; opp_index=0; focus="opportunities"; detail=False
    while True:
        d=load(); h,cols=w.getmaxyx(); w.erase()
        offers=sorted(d.get("offers",{}).values(),
                      key=lambda o:(o.get("currency",""),o.get("payment",""),o.get("id","")))
        events=list(reversed(d.get("events",[])))
        active=sum(bool(o.get("enabled")) for o in offers); paused=len(offers)-active
        healthy=d.get("healthy") is True
        put(w,0,0," BISQ TOP ",curses.color_pair(4)|curses.A_BOLD)
        prices=d.get("market_prices",{})
        quote=f"BTC/BRL {money(prices.get('BRL'),'BRL')}  BTC/EUR {money(prices.get('EUR'),'EUR')}"
        if cols>=105: put(w,0,12,"Ofertas e alertas em tempo real")
        put(w,0,max(12,cols-len(quote)-1),quote,curses.color_pair(4)|curses.A_BOLD)
        put(w,1,0,"Bisq: "+("ONLINE" if healthy else "ERRO"),
            curses.color_pair(1 if healthy else 2)|curses.A_BOLD)
        dao=d.get("dao_synced") is True
        put(w,1,18,"DAO: "+("OK" if dao else "SINCRONIZANDO"),
            curses.color_pair(1 if dao else 3))
        put(w,1,max(0,cols-25),"Atualizado há "+age(d.get("last_check")))
        put(w,2,0,f"ATIVAS: {active}",curses.color_pair(1)|curses.A_BOLD)
        put(w,2,18,f"PAUSADAS: {paused}",curses.color_pair(3)|curses.A_BOLD)
        if d.get("last_error"): put(w,3,0,"ALERTA: "+str(d["last_error"]),curses.color_pair(2)|curses.A_BOLD)
        opportunities=d.get("opportunities",[])
        opp_index=max(0,min(opp_index,max(0,len(opportunities)-1)))
        if detail and opportunities:
            put(w,0,0," BISQ TOP — DETALHES ",curses.color_pair(4)|curses.A_BOLD)
            for row,line in enumerate(opportunity_details(opportunities[opp_index],prices),2):
                if row>=h-1: break
                style=curses.color_pair(1)|curses.A_BOLD if row in (2,4) else 0
                put(w,row,1,cut(line,cols-2),style)
            put(w,h-1,0,"Esc/Enter voltar • ↑/↓ trocar oportunidade • q sair",curses.A_DIM)
            w.refresh(); key=w.getch()
            if key in (ord("q"),ord("Q")): break
            if key in (27,10,13): detail=False
            elif key in (curses.KEY_DOWN,ord("j")): opp_index=min(max(0,len(opportunities)-1),opp_index+1)
            elif key in (curses.KEY_UP,ord("k")): opp_index=max(0,opp_index-1)
            continue
        y=5; put(w,y,0,"OPORTUNIDADES",curses.A_BOLD|curses.A_UNDERLINE); y+=1
        if not opportunities:
            put(w,y,0,"Nenhum sinal acima do limite configurado.",curses.A_DIM); y+=1
        visible_opps=min(len(opportunities),max(1,min(6,h//7)))
        opp_offset=max(0,min(opp_index,max(0,len(opportunities)-visible_opps)))
        for index,item in enumerate(opportunities[opp_offset:opp_offset+visible_opps],opp_offset):
            line=(f"{item.get('action','')} {item.get('currency','')}  "
                  f"VANTAGEM {float(item.get('advantage_pct',0)):.2f}%  "
                  f"{item.get('price','')}/BTC  {item.get('btc_range','')} BTC  "
                  f"{item.get('payment','')}  …{item.get('id','')[-10:]}")
            style=curses.color_pair(5)|curses.A_BOLD
            if focus=="opportunities" and index==opp_index: style|=curses.A_REVERSE
            put(w,y,0,cut(line,cols-1),style); y+=1
        y+=1; put(w,y,0,"MINHAS OFERTAS",curses.A_BOLD|curses.A_UNDERLINE); y+=1
        put(w,y,0,f"{'ST':<4} {'LADO':<6} {'MOEDA':<5} {'FAIXA BTC':<23} {'VALOR EM MOEDA':<19} {'PREÇO/BTC':<15} {'MÉTODO':<11} ID",
            curses.color_pair(4)|curses.A_BOLD); y+=1
        rows=max(1,min(len(offers),max(1,h-y-8)))
        for o in offers[:rows]:
            on=o.get("enabled")
            line=(f"{'ON' if on else 'OFF':<4} {o.get('direction',''):<6} {o.get('currency',''):<5} "
                  f"{o.get('btc_range',''):<23} {o.get('fiat_range',''):<19} "
                  f"{o.get('price',''):<15} {o.get('payment',''):<11} "
                  f"…{o.get('id','')[-10:]}")
            put(w,y,0,cut(line,cols-1),curses.color_pair(1 if on else 3)); y+=1
        y+=1; put(w,y,0,"ALERTAS / EVENTOS",curses.A_BOLD|curses.A_UNDERLINE); y+=1
        available=max(1,h-y-2)
        if not events: put(w,y,0,"Nenhum evento registrado ainda.",curses.A_DIM)
        for e in events[scroll:scroll+available]:
            kind=e.get("kind","event")
            if kind in ("accepted","opportunity"): style=curses.color_pair(5)|curses.A_BOLD; marker="*** "+("ACEITA" if kind=="accepted" else "OPORTUNIDADE")+" ***"
            elif kind=="error": style=curses.color_pair(2)|curses.A_BOLD; marker="ERRO"
            elif kind in ("paused","warning","removed"): style=curses.color_pair(3)|curses.A_BOLD; marker=kind.upper()
            else: style=curses.color_pair(1); marker=kind.upper()
            stamp=e.get("time","")[5:19].replace("T"," ")
            put(w,y,0,cut(f"{stamp} [{marker}] {e.get('title','')} — {e.get('detail','')}",cols-1),style); y+=1
        put(w,h-1,0,"q sair • Tab alternar seção • ↑/↓ navegar • Enter detalhes • atualização: 1s",curses.A_DIM); w.refresh()
        key=w.getch()
        if key in (ord("q"),ord("Q")): break
        if key==9: focus="events" if focus=="opportunities" else "opportunities"
        elif key in (10,13) and focus=="opportunities" and opportunities: detail=True
        elif key in (curses.KEY_DOWN,ord("j")):
            if focus=="opportunities": opp_index=min(max(0,len(opportunities)-1),opp_index+1)
            else: scroll=min(max(0,len(events)-available),scroll+1)
        elif key in (curses.KEY_UP,ord("k")):
            if focus=="opportunities": opp_index=max(0,opp_index-1)
            else: scroll=max(0,scroll-1)

if __name__=="__main__": curses.wrapper(main)
