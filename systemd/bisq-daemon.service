[Unit]
Description=Bisq 1 headless daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk
EnvironmentFile=%h/.config/bisq/daemon.env
ExecStart=/usr/bin/bisq-daemon --appDataDir=%h/.local/share/Bisq --apiPassword=${BISQ_API_PASSWORD} --apiPort=9998 --maxMemory=2048
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/Bisq

[Install]
WantedBy=default.target
